# Hygraph GraphQL endpoint URL
GRAPH_CMS_URL=

# Hygraph Personal Access Token (never exposed to the browser)
GRAPH_CMS_PAT=

# Google Analytics measurement ID — prefix with VITE_ so Vite exposes it to the client
# Optional. Leave empty to disable analytics.
VITE_GA_TRACKING_ID=

# Spotify app credentials (developer.spotify.com/dashboard), used via the
# Client Credentials flow to list public playlists on /playlists. Never
# exposed to the browser — see scripts/spotify.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The account's Spotify user ID (the id in open.spotify.com/user/<id>)
SPOTIFY_USER_ID=

# Optional, comma-separated. Spotify's playlists-list endpoint sometimes
# omits a playlist that Spotify itself reports as public and owned by this
# account (a confirmed Spotify API inconsistency). List those playlist IDs
# here (the id in open.spotify.com/playlist/<id>) to fetch and include them
# individually. Leave empty if you don't need it.
SPOTIFY_EXTRA_PLAYLIST_IDS=
